{
  "name": "smriti",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade agentic memory assistant",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @smriti/api dev",
    "dev:worker": "pnpm --filter @smriti/worker dev",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "pnpm --filter @smriti/harness build && pnpm --filter @smriti/eval build && node packages/eval/dist/cli.js",
    "eval:replay": "pnpm --filter @smriti/harness build && pnpm --filter @smriti/eval build && node packages/eval/dist/cli.js replay",
    "eval:diff": "pnpm --filter @smriti/harness build && pnpm --filter @smriti/eval build && node packages/eval/dist/cli.js diff",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:studio": "prisma studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@prisma/client": "^6.1.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
