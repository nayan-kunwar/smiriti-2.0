generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum MemoryType {
  long_term
  semantic
}

enum EmbeddingStatus {
  pending
  indexed
  failed
}

enum MessageRole {
  user
  assistant
  system
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @map("created_at")

  refreshTokens   RefreshToken[]
  apiKeys         ApiKey[]
  memories        Memory[]
  conversations   Conversation[]
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  keyHash    String    @map("key_hash")
  name       String
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Memory {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  type           MemoryType
  content        String     @db.Text
  category       String?
  tags           String[]
  importance     Float      @default(0.5)
  confidence     Float      @default(0.8)
  isPinned       Boolean    @default(false) @map("is_pinned")
  isArchived     Boolean    @default(false) @map("is_archived")
  conversationId String?    @map("conversation_id") @db.Uuid
  contentHash    String     @map("content_hash")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  embeddings   MemoryEmbedding[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, category])
  @@map("memories")
}

model MemoryEmbedding {
  id             String          @id @default(uuid()) @db.Uuid
  memoryId       String          @map("memory_id") @db.Uuid
  chunkIndex     Int             @default(0) @map("chunk_index")
  tokenCount     Int             @map("token_count")
  provider       String
  model          String
  dimension      Int
  qdrantPointId  String          @map("qdrant_point_id")
  status         EmbeddingStatus @default(pending)
  indexedAt      DateTime?       @map("indexed_at")

  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@map("memory_embeddings")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]
  memories Memory[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMessage {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String      @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_messages")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  action          String
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id") @db.Uuid
  payloadSnapshot Json     @map("payload_snapshot")
  correlationId   String   @map("correlation_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model IdempotencyKey {
  key              String   @id
  userId           String   @map("user_id") @db.Uuid
  requestHash      String   @map("request_hash")
  responseSnapshot Json     @map("response_snapshot")
  expiresAt        DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("idempotency_keys")
}
