NODE_ENV=development
PORT=3000
WORKER_METRICS_PORT=9464
LOG_LEVEL=debug

DATABASE_URL=postgresql://smriti:smriti@localhost:5433/smriti?schema=public
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=smriti_dev_dmr_768

EMBEDDING_PROVIDER=dmr
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
DMR_BASE_URL=http://localhost:12434/engines/v1
DMR_EMBED_MODEL=docker.io/ai/nomic-embed-text-v1.5:latest
DMR_CHAT_MODEL=docker.io/ai/qwen2.5:3B-Q4_K_M
# From inside docker compose api/worker containers use:
# DMR_BASE_URL=http://model-runner.docker.internal/engines/v1

LLM_PROVIDER=dmr
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_EXPENSIVE_TTL=60
RATE_LIMIT_EXPENSIVE_MAX=20
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_TIMEOUT_MS=2000

IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_LOCK_TIMEOUT_MS=30000
IDEMPOTENCY_CLEANUP_INTERVAL_MINUTES=60

JOB_ATTEMPTS=3
JOB_BACKOFF_DELAY_MS=1000
JOB_REMOVE_ON_COMPLETE=100
JOB_REMOVE_ON_FAIL=500
JOB_FAILURE_RETENTION_DAYS=30
JOB_FAILURE_CLEANUP_INTERVAL_MINUTES=60

RECONCILE_ENABLED=true
RECONCILE_INTERVAL_MINUTES=15
RECONCILE_BATCH_SIZE=100
RECONCILE_MAX_ENQUEUE=500

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=smriti
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

CORRELATION_ID_HEADER=x-correlation-id
